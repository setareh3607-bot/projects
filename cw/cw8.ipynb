   "source": [
    "# داده مربوط به یک هفته\n",
    "x = 2.0\n",
    "y = 10.0\n",
    "\n",
    "# پارامترهای اولیه مدل\n",
    "w = 2.0\n",
    "b = 3.0\n",
    "\n",
    "# پیش‌بینی\n",
    "y_pred = w * x + b\n",
    "\n",
    "# اختلاف و زیان مربعی\n",
    "error = y_pred - y\n",
    "loss = error ** 2\n",
    "\n",
    "print(\"Prediction:\", y_pred)\n",
    "print(\"Error:\", error)\n",
    "print(\"Squared loss:\", loss)\n"
   ]
  }
 ],
